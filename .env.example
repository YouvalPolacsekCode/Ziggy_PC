# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit it.

# OpenAI
OPENAI_API_KEY=sk-...

# Home Assistant
HA_URL=http://homeassistant.local:8123/
HA_TOKEN=your_long_lived_token

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USERS=123456789

# MQTT
MQTT_HOST=192.168.1.x
MQTT_PORT=1883
MQTT_USERNAME=ziggy
MQTT_PASSWORD=your_mqtt_password

# SerpAPI (optional — web search)
SERPAPI_API_KEY=your_serpapi_key

# Azure Cognitive Services (Neural TTS)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# ── Relay only (relay/ on Fly — `fly secrets set`, not the hub's .env) ──────
# Error reporting (relay/app/observability.py). Unset = Sentry off.
SENTRY_DSN=
# Hub usage counters → PostHog server-side (relay/app/posthog_forward.py).
# Unset = forwarding off. POSTHOG_HOST defaults to the EU ingest host.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
